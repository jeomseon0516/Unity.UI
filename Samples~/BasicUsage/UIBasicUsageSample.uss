.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 32px;
    background-color: rgb(24, 28, 38);
    color: rgb(235, 239, 248);
}

.title { font-size: 28px; -unity-font-style: bold; margin-bottom: 18px; }
.section-title { font-size: 18px; -unity-font-style: bold; margin-top: 10px; margin-bottom: 8px; }
/* .. flex-shrink 기본값(1)이면 화면이 짧을 때 이 영역이 눌려 높이가 0에 가까워지고,
   UICarousel이 높이 기준으로 아이템 크기를 계산하므로 아이템이 전부 한 점에 겹칩니다. */
.carousel-host { height: 150px; flex-shrink: 0; }
.sample-carousel { flex-grow: 1; }
.carousel-item { align-items: center; justify-content: center; background-color: rgb(53, 103, 176); border-radius: 10px; font-size: 18px; -unity-text-align: middle-center; }
.selection-label { margin-top: 6px; -unity-text-align: middle-center; }
.button-row { flex-direction: row; justify-content: center; margin-top: 8px; margin-bottom: 12px; flex-shrink: 0; }
.button-row > Button { min-width: 120px; margin-left: 4px; margin-right: 4px; }
.grid-scroll { flex-grow: 1; min-height: 220px; }
.grid-host { flex-shrink: 0; }
.sample-grid { flex-shrink: 0; }
.grid-item { align-items: center; justify-content: center; background-color: rgb(65, 73, 92); border-radius: 6px; -unity-text-align: middle-center; }
/* .. UIView 파생 루트는 기본 크기가 auto라, 자식이 전부 position:absolute면 높이가 0으로
   붕괴해 자식의 top/bottom이 풀리지 않습니다. 화면 전체를 덮는 화면은 루트에 이 클래스를 줍니다. */
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.65); }
.popup { width: 420px; padding: 28px; border-radius: 12px; background-color: rgb(245, 247, 252); color: rgb(24, 28, 38); }
.popup-title { font-size: 22px; -unity-font-style: bold; margin-bottom: 8px; }
.popup-description { margin-bottom: 18px; }
.loading-toast { position: absolute; right: 24px; top: 24px; width: 260px; padding: 16px; border-radius: 10px; background-color: rgba(24, 28, 38, 0.92); color: rgb(235, 239, 248); }
.loading-title { font-size: 16px; -unity-font-style: bold; margin-bottom: 6px; }
.loading-description { margin-bottom: 12px; white-space: normal; }
